	}

	.modal-icon {
		width: 56px;
		height: 56px;
		object-fit: contain;
		margin-bottom: 0.75em;
	}

	.modal-title {
		font-size: 1.2em;
		margin: 0 0 0.5em;
		color: var(--white);
	}

	.modal-desc {
		font-size: 0.9em;
		color: var(--white-muted);
		line-height: 1.7;
		margin: 0;
	}

	/* Scroll animations */
	.reveal {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity 0.6s ease, transform 0.6s ease;
	}

	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.reveal-delay-1 { transition-delay: 0.1s; }
	.reveal-delay-2 { transition-delay: 0.2s; }
