<script>
	const skills: Record<string, string> = {
		'Java': 'A class-based, object-oriented programming language widely used for building enterprise applications, Android apps, and backend systems.',
		'C++': 'A powerful systems programming language that extends C with object-oriented features. Used for performance-critical applications and competitive programming.',
		'Python': 'A versatile, beginner-friendly language known for clean syntax. Popular in data science, automation, web development, and scripting.',
		'PHP': 'A server-side scripting language designed for web development. Powers a large portion of the web, including frameworks like Laravel and Yii2.',
		'JavaScript': 'The language of the web. Runs in browsers and on servers (via Node.js), enabling interactive and dynamic web experiences.',
		'TypeScript': 'A typed superset of JavaScript that catches errors at compile time. Makes large codebases easier to maintain and refactor.',
		'Kotlin': 'A modern, concise language for Android development. Fully interoperable with Java and officially recommended by Google for Android apps.',
		'HTML': 'The standard markup language for creating web pages. Defines the structure and content of every website on the internet.',
		'CSS/SCSS': 'CSS is the styling language for the web; SCSS is a preprocessor that adds variables, nesting, and mixins to make stylesheets more maintainable.',
		'Yii2 Framework': 'A high-performance PHP framework following the MVC pattern. Used for building robust web applications quickly with built-in tools.',
		'Ruby on Rails': 'A full-stack web framework for Ruby that follows convention over configuration. Known for rapid development and clean code structure.',
		'Angular': 'A TypeScript-based web application framework by Google for building structured, component-driven single-page applications.',
		'Ionic': 'A UI toolkit for building cross-platform mobile apps with web technologies. Write once, run on Android, iOS, and the web.',
		'Capacitor': 'A cross-platform native runtime that turns web apps (PWA) into native mobile apps with access to device APIs.',
		'PWA': 'Progressive Web App — a web app that can be installed, works offline, and feels like a native app, from a single web codebase.',
		'Vue': 'A progressive JavaScript framework for building user interfaces, known for its approachable, component-based design.',
		'Quasar': 'A Vue.js-based framework for building responsive SPAs, mobile apps, and desktop apps from a single codebase.',
		'Database Design & Management': 'Structuring databases for efficiency and integrity — normalization, relational schemas, indexing — and keeping them running smoothly.',
		'MySQL': 'A popular open-source relational database. Widely used in web applications for storing and querying structured data.',
		'PostgreSQL': 'A powerful, open-source relational database known for reliability, advanced features, and standards compliance.',
		'SQL': 'Structured Query Language — the standard language for querying and managing data in relational databases.',
		'DBeaver': 'A universal database tool for connecting to, browsing, and querying many kinds of databases from one place.',
		'ERD': 'Entity-Relationship Diagram — a visual model of a database showing entities, their attributes, and how they relate.',
		'Data Modelling': 'Defining how data is structured, related, and constrained so that systems store it consistently and efficiently.',
		'ETL Concepts': 'Extract, Transform, Load — the process of moving data from source systems, reshaping it, and loading it into a target store.',
		'Authentication & RBAC': 'Verifying who a user is, and Role-Based Access Control — granting each user only the permissions their role needs.',
		'Postman': 'A platform for designing, testing, and documenting APIs by sending and inspecting HTTP requests.',
		'Git': 'A distributed version control system for tracking code changes, collaborating with teams, and managing project history.',
		'GitHub': 'A cloud-based platform for hosting Git repositories. The standard for open-source collaboration and code sharing.',
		'GitHub Actions (CI/CD)': 'GitHub\'s automation platform for building, testing, and deploying code automatically on every push.',
		'Docker': 'A platform for containerizing applications so they run consistently across any environment — development, testing, or production.',
		'Vercel': 'A cloud platform for deploying and hosting web applications and static sites with minimal configuration.',
		'Figma': 'A cloud-based design tool for UI/UX. Used for wireframing, prototyping, and collaborating on interface designs.',
		'Android Studio': 'The official IDE for Android development. Provides tools for building, testing, and debugging Android apps.',
		'VS Code': 'A lightweight, extensible code editor with a huge ecosystem of extensions for almost every language.',
		'Laragon': 'A portable local development environment for Windows that bundles PHP, MySQL, and web servers.',
		'Object-Oriented Programming (OOP)': 'A paradigm that organizes code into objects with properties and methods. Core principles: Encapsulation, Inheritance, Polymorphism, and Abstraction.',
		'System Analysis & Design': 'Studying how a system should work and defining its architecture, components, and data flow before it is built.',
		'SDLC': 'Software Development Life Cycle — a structured process for planning, creating, testing, and deploying software, from requirements to maintenance.',
		'Requirements Specification (URS)': 'A User Requirements Specification captures what users need a system to do, forming the agreed basis for design and testing.',
		'Technical Documentation': 'Documents that explain how a system is designed, built, and maintained — for developers and administrators.',
		'User Manuals': 'Step-by-step guides that help end users understand and operate a system.',
		'Flowcharts': 'Diagrams that map out a process or system logic step by step, making workflows easy to understand.',
		'UAT': 'User Acceptance Testing — the final testing phase where real users confirm the system meets their needs before go-live.',
	};

	const modal = document.getElementById('skillModal');
	const modalTitle = document.getElementById('modalTitle');
	const modalDesc = document.getElementById('modalDesc');
	const modalIcon = document.getElementById('modalIcon') as HTMLImageElement;
	const modalClose = document.getElementById('modalClose');

	document.querySelectorAll('.skill-item[data-skill]').forEach((el) => {
		el.addEventListener('click', () => {
			const name = (el as HTMLElement).dataset.skill!;
			const img = el.querySelector('img');
			const emojiSpan = el.querySelector('.skill-emoji');
			if (modalTitle) modalTitle.textContent = name;
			if (modalDesc) modalDesc.textContent = skills[name] ?? 'A tool I use in my development workflow.';
			if (modalIcon) {
				if (img) {
					modalIcon.src = img.src;
					modalIcon.alt = name;
					modalIcon.style.filter = img.style.filter ?? '';
					modalIcon.style.display = 'block';
				} else if (emojiSpan) {
					modalIcon.removeAttribute('src');
					modalIcon.alt = '';
					modalIcon.style.display = 'none';
					if (modalTitle) modalTitle.textContent = `${emojiSpan.textContent} ${name}`;
				}
			}
			modal?.classList.add('open');
		});
	});

	modalClose?.addEventListener('click', () => modal?.classList.remove('open'));
	modal?.addEventListener('click', (e) => {
		if (e.target === modal) modal.classList.remove('open');
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') modal?.classList.remove('open');
	});

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
				} else {
					entry.target.classList.remove('visible');
				}
			});
		},
		{ threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
	);

	document.querySelectorAll('.reveal').forEach((el) => {
		observer.observe(el);
	});
</script>
