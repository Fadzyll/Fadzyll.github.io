---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ekafaImg from '../assets/Screenshot 2026-05-24 205448.png';
import kindergartenImg from '../assets/photo_2026-05-24_20-59-13.jpg';
import cgpaImg from '../assets/cgpa-calculator.png';
import korSuksisImg from '../assets/kor-suksis.jpg';

import { getGithubStats } from '../lib/githubStats';

// Fetched from GitHub at build time (see src/lib/githubStats.ts); "+" marks fallback values.
const githubStats = await getGithubStats();
const topLanguages = githubStats.topLanguages;
const plus = githubStats.live ? '' : '+';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects — Fadzyll"
			description="Software projects I've built — from web apps to mobile apps, with the tools and technologies behind them."
			keywords="Fadzil Bin Ismail, Fadzyll, projects, portfolio, web apps, mobile apps, software projects"
		/>
	</head>
	<body>
		<Header />
		<main>

			<!-- Hero -->
			<section class="page-hero">
				<p class="section-label reveal">// what i've built</p>
				<h1 class="reveal reveal-delay-1">Projects & <span class="accent">Skills</span></h1>
				<p class="lead reveal reveal-delay-2">A collection of things I've built — from client projects at ST Datablu to final year projects and personal experiments. Each one taught me something new.</p>
			</section>

			<!-- Industry Projects -->
			<section class="section">
				<p class="section-label reveal">// industry work</p>
				<h2 class="reveal reveal-delay-1">Industry Projects at ST Datablu</h2>
				<p class="section-note reveal reveal-delay-2">Client projects are confidential — these describe what I built and my role, without client data or internal links.</p>
				<div class="projects-list">

					<div class="project-card no-image reveal reveal-delay-1">
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Client · Sabah Tourism Board</span>
								<span class="project-status active">● Ongoing</span>
								<span class="project-private">🔒 Confidential</span>
							</div>
							<h3>Rural Tourism Project</h3>
							<p class="project-date">Mar 2026 — Present</p>
							<p class="project-desc">A Progressive Web App (PWA) for Sabah Tourism Board (STB), built from module, database, and system design through to testing — with the Android app published on the Google Play Store.</p>
							<div class="project-highlights">
								<span class="highlight-item">🏗️ Module, database & system design through to testing</span>
								<span class="highlight-item">📱 Android app published on the Google Play Store</span>
								<span class="highlight-item">📘 User manual & technical documentation</span>
								<span class="highlight-item">🤝 UAT and onboarding sessions with STB operators across several districts in Sabah</span>
								<span class="highlight-item">🛠️ Ongoing support & bug fixes</span>
							</div>
						</div>
					</div>

					<div class="project-card no-image reveal reveal-delay-2">
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Client · Department of Fisheries Brunei</span>
								<span class="project-status active">● Ongoing</span>
								<span class="project-private">🔒 Confidential</span>
							</div>
							<h3>Fisherman System</h3>
							<p class="project-date">Mar 2026 — Present</p>
							<p class="project-desc">A system for the Department of Fisheries Brunei. I worked on the requirements, data model, and UI, and developed features for both the user and admin sides.</p>
							<div class="project-highlights">
								<span class="highlight-item">📋 User Requirements Specification (URS), ERD & UI redesign</span>
								<span class="highlight-item">🎨 Mockup UI pages for several modules</span>
								<span class="highlight-item">💻 Features for both the user and admin sides</span>
								<span class="highlight-item">✈️ Attended project progress updates in Brunei</span>
							</div>
						</div>
					</div>

					<div class="project-card no-image reveal reveal-delay-3">
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Client · FAMA</span>
								<span class="project-status active">● Ongoing</span>
								<span class="project-private">🔒 Confidential</span>
							</div>
							<h3>FAMA Agri Market Insight (AMI)</h3>
							<p class="project-date">Jul 2026 — Present</p>
							<p class="project-desc">Documentation, user workshops, and UAT for FAMA's Agri Market Insight system.</p>
							<div class="project-highlights">
								<span class="highlight-item">🔀 System flowcharts & technical documentation, after learning the system at the company's Brunei branch office with the project manager</span>
								<span class="highlight-item">🧑‍🏫 User workshops in Kelantan, Sabah, Perak & Pulau Pinang</span>
								<span class="highlight-item">✅ Prepared UAT forms, attended the UAT session at FAMA's office in Kuala Lumpur & compiled user feedback</span>
							</div>
						</div>
					</div>

					<div class="project-card no-image reveal reveal-delay-1">
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">ST Datablu</span>
								<span class="project-status done">✓ Completed</span>
								<span class="project-private">🔒 Confidential</span>
							</div>
							<h3>Client Support Portal</h3>
							<p class="project-date">Mar 2026 — Jul 2026</p>
							<p class="project-desc">A web platform, built with a teammate, to replace manual WhatsApp handling of client support requests — from technical analysis to delivery.</p>
							<div class="project-highlights">
								<span class="highlight-item">🔍 Technical analysis, reviewed with the senior developer</span>
								<span class="highlight-item">🗄️ Database & UI design for my modules</span>
								<span class="highlight-item">⚙️ Set up the development environment & made the system accessible online before the domain was ready</span>
							</div>
						</div>
					</div>

					<div class="project-card no-image reveal reveal-delay-2">
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Training & Talks</span>
								<span class="project-status done">✓ Completed</span>
							</div>
							<h3>Training & Speaking Engagements</h3>
							<p class="project-date">Mar 2026 — Sep 2026</p>
							<p class="project-desc">Sharing knowledge with clients and professionals as part of my work at ST Datablu.</p>
							<div class="project-highlights">
								<span class="highlight-item">🗄️ Co-facilitated an 8-module FAMA SQL Analytics Training workshop for 12 participants and wrote the training report</span>
								<span class="highlight-item">🎤 Gave a talk at the Digital Workplace Transformation Masterclass (Rapid Axel Sdn Bhd) on AI, prompting, cybersecurity, and data & digital safety</span>
							</div>
						</div>
					</div>

				</div>
			</section>

			<!-- Projects -->
			<section class="section">
				<p class="section-label reveal">// projects</p>
				<h2 class="reveal reveal-delay-1">Personal & Academic Projects</h2>
				<div class="projects-list">

					<div class="project-card reveal reveal-delay-1">
						<div class="project-image">
							<img src={ekafaImg.src} alt="eKAFA PIUMS screenshot" class="project-screenshot" />
						</div>
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Final Year Project</span>
								<span class="project-status done">✓ Completed</span>
								<span class="project-private">🔒 Private Repo</span>
							</div>
							<h3>eKAFA PIUMS</h3>
							<p class="project-date">Feb 2025 — February 2026</p>
							<p class="project-desc">A web-based school management system built to replace traditional paper-based processes for managing KAFA workload. The system digitizes day-to-day operations, making it easier for administrators and teachers to manage tasks efficiently.</p>
							<div class="project-highlights">
								<span class="highlight-item">📋 Digitizes KAFA workload management</span>
								<span class="highlight-item">🔐 Role-based access control</span>
								<span class="highlight-item">📊 Admin dashboard & reporting</span>
							</div>
							<div class="project-tags">
								<span class="tag">PHP</span>
								<span class="tag">Yii2 MVC</span>
								<span class="tag">JavaScript</span>
								<span class="tag">MySQL</span>
								<span class="tag">CSS</span>
								<span class="tag">Git</span>
								<span class="tag">Laragon</span>
							</div>
						</div>
					</div>

					<div class="project-card reveal reveal-delay-2">
						<div class="project-image">
							<img src={kindergartenImg.src} alt="Kindergarten App screenshot" class="project-screenshot project-screenshot-mobile" />
						</div>
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Mobile App</span>
								<span class="project-status done">✓ Completed</span>
							</div>
							<h3>Kindergarten Management App</h3>
							<p class="project-date">March 2025 — July 2025</p>
							<p class="project-desc">A simple mobile application designed for kindergarten settings, allowing teachers to manage student data and attendance in one place.</p>
							<div class="project-highlights">
								<span class="highlight-item">👶 Student data management</span>
								<span class="highlight-item">📅 Attendance tracking</span>
							</div>
							<div class="project-tags">
								<span class="tag">Kotlin</span>
								<span class="tag">Jetpack Compose</span>
								<span class="tag">Room Database</span>
								<span class="tag">MVVM</span>
								<span class="tag">Material 3</span>
							</div>
						</div>
					</div>

					<div class="project-card reveal reveal-delay-3">
						<div class="project-image">
							<img src={korSuksisImg.src} alt="KOR SUKSIS Lampiran A Generator screenshot" class="project-screenshot project-screenshot-mobile" />
						</div>
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Desktop & Mobile App</span>
								<span class="project-status done">✓ Completed</span>
							</div>
							<h3>KOR SUKSIS — Lampiran A Generator</h3>
							<p class="project-date">2025</p>
							<p class="project-desc">A cross-platform app (Windows, Mac & Android) for KOR SUKSIS UMS that automatically generates Borang JPJKK/KSS/004/22 (Lampiran A) and Daftar Kedatangan. Data stays 100% local — no internet, no server, no cloud.</p>
							<div class="project-highlights">
								<span class="highlight-item">📋 Auto-generates Lampiran A PDF</span>
								<span class="highlight-item">📱 Works on Windows, Mac & Android</span>
								<span class="highlight-item">🔒 100% offline — data stays local</span>
							</div>
							<div class="project-tags">
								<span class="tag">HTML</span>
								<span class="tag">CSS</span>
								<span class="tag">JavaScript</span>
								<span class="tag">Vite 5</span>
								<span class="tag">Tauri 2</span>
								<span class="tag">Capacitor 6</span>
								<span class="tag">SQLite</span>
								<span class="tag">jsPDF 2</span>
							</div>
							<div class="project-links">
								<a href="https://github.com/Fadzyll/kor-suksis" target="_blank" rel="noopener noreferrer" class="btn btn-outline">GitHub →</a>
							</div>
						</div>
					</div>

					<div class="project-card reveal reveal-delay-3">
						<div class="project-image">
							<img src={cgpaImg.src} alt="CGPA Calculator screenshot" class="project-screenshot project-screenshot-mobile" />
						</div>
						<div class="project-info">
							<div class="project-meta">
								<span class="project-badge">Web App</span>
								<span class="project-status done">✓ Completed</span>
							</div>
							<h3>CGPA Calculator</h3>
							<p class="project-date">2025</p>
							<p class="project-desc">A web-based CGPA calculator tailored for Malaysian public university students. Supports semester GPA calculation, cumulative CGPA tracking, target GPA planning, and a full grade reference — all based on the UMS grading policy.</p>
							<div class="project-highlights">
								<span class="highlight-item">🎓 Semester & cumulative CGPA</span>
								<span class="highlight-item">🎯 Target GPA planner</span>
								<span class="highlight-item">📊 UMS grading policy</span>
							</div>
							<div class="project-tags">
								<span class="tag">Astro</span>
								<span class="tag">JavaScript</span>
								<span class="tag">TypeScript</span>
								<span class="tag">CSS</span>
							</div>
							<div class="project-links">
								<a href="https://cgpa-calculator-unimy.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">🌐 Live Demo</a>
							</div>
						</div>
					</div>

				</div>
			</section>

			<!-- GitHub Stats -->
			<section class="section">
				<p class="section-label reveal">// open source</p>
				<h2 class="reveal reveal-delay-1">GitHub Activity</h2>
				<div class="gh-stats-grid reveal reveal-delay-2">
					<div class="gh-stat-card">
						<span class="gh-stat-value">{githubStats.publicRepos}</span>
						<span class="gh-stat-label">Public Repos</span>
					</div>
					<div class="gh-stat-card">
						<span class="gh-stat-value">{githubStats.commitsThisYear}{plus}</span>
						<span class="gh-stat-label">Commits This Year</span>
					</div>
					<div class="gh-stat-card">
						<span class="gh-stat-value">{githubStats.contributionsLastYear}{plus}</span>
						<span class="gh-stat-label">Contributions (Last Year)</span>
					</div>
					<div class="gh-stat-card">
						<span class="gh-stat-value">{githubStats.activeSince}</span>
						<span class="gh-stat-label">Active Since</span>
					</div>
				</div>

				{topLanguages.length > 0 && (
					<div class="gh-languages reveal reveal-delay-3">
						<p class="gh-lang-title">Top Languages</p>
						<div class="gh-lang-bar">
							{topLanguages.map(lang => (
								<div class="gh-lang-segment" style={`width: ${lang.percent}%; background: ${lang.color};`} title={`${lang.name} ${lang.percent}%`}></div>
							))}
						</div>
						<div class="gh-lang-legend">
							{topLanguages.map(lang => (
								<span class="gh-lang-item">
									<span class="gh-lang-dot" style={`background: ${lang.color};`}></span>
									{lang.name} <span class="gh-lang-pct">{lang.percent}%</span>
								</span>
							))}
						</div>
					</div>
				)}

				<div class="gh-profile-link reveal reveal-delay-4">
					<a href="https://github.com/Fadzyll" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
						<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
						</svg>
						View GitHub Profile →
					</a>
				</div>
			</section>

			<!-- Skills -->
			<section class="section">
				<p class="section-label reveal">// skills</p>
				<h2 class="reveal reveal-delay-1">Technical Skills</h2>
				<p class="skill-hint reveal reveal-delay-2"><span aria-hidden="true">👆</span> Click or tap any icon to see what it is</p>
				<div class="skills-grid">

					<div class="skill-group reveal reveal-delay-1">
						<h3 class="skill-group-title">
							<span class="skill-group-icon">🧠</span> Analysis & Documentation
						</h3>
						<div class="concepts-tags">
							<span class="tag">Object-Oriented Programming (OOP)</span>
							<span class="tag">System Analysis & Design</span>
							<span class="tag">SDLC</span>
							<span class="tag">Requirements Specification (URS)</span>
							<span class="tag">Technical Documentation</span>
							<span class="tag">User Manuals</span>
							<span class="tag">Flowcharts</span>
							<span class="tag">UAT</span>
						</div>
					</div>

					<div class="skill-group reveal reveal-delay-2">
						<h3 class="skill-group-title">
							<span class="skill-group-icon">💬</span> Programming & Frameworks
						</h3>
						<div class="skill-list">
							<div class="skill-item" data-skill="Java">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg" alt="Java" />
								<span>Java</span>
							</div>
							<div class="skill-item" data-skill="C++">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cplusplus/cplusplus-original.svg" alt="C++" />
								<span>C++</span>
							</div>
							<div class="skill-item" data-skill="Python">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" />
								<span>Python</span>
							</div>
							<div class="skill-item" data-skill="PHP">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/php/php-original.svg" alt="PHP" />
								<span>PHP</span>
							</div>
							<div class="skill-item" data-skill="JavaScript">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="JavaScript" />
								<span>JavaScript</span>
							</div>
							<div class="skill-item" data-skill="Kotlin">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kotlin/kotlin-original.svg" alt="Kotlin" />
								<span>Kotlin</span>
							</div>
							<div class="skill-item" data-skill="HTML">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg" alt="HTML" />
								<span>HTML</span>
							</div>
							<div class="skill-item" data-skill="TypeScript">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" alt="TypeScript" />
								<span>TypeScript</span>
							</div>
							<div class="skill-item" data-skill="CSS/SCSS">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/sass/sass-original.svg" alt="CSS/SCSS" />
								<span>CSS/SCSS</span>
							</div>
							<div class="skill-item" data-skill="Yii2 Framework">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/yii/yii-original.svg" alt="Yii2 Framework" />
								<span>Yii2 Framework</span>
							</div>
							<div class="skill-item" data-skill="Ruby on Rails">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/rails/rails-plain.svg" alt="Ruby on Rails" />
								<span>Ruby on Rails</span>
							</div>
							<div class="skill-item" data-skill="Angular">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/angular/angular-original.svg" alt="Angular" />
								<span>Angular</span>
							</div>
							<div class="skill-item" data-skill="Ionic">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/ionic/ionic-original.svg" alt="Ionic" />
								<span>Ionic</span>
							</div>
							<div class="skill-item" data-skill="Capacitor">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/capacitor/capacitor-original.svg" alt="Capacitor" />
								<span>Capacitor</span>
							</div>
							<div class="skill-item" data-skill="PWA">
								<span class="skill-emoji">📲</span>
								<span>PWA</span>
							</div>
							<div class="skill-item" data-skill="Vue">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vuejs/vuejs-original.svg" alt="Vue" />
								<span>Vue</span>
							</div>
							<div class="skill-item" data-skill="Quasar">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/quasar/quasar-original.svg" alt="Quasar" />
								<span>Quasar</span>
							</div>
						</div>
					</div>

					<div class="skill-group reveal reveal-delay-3">
						<h3 class="skill-group-title">
							<span class="skill-group-icon">🗄️</span> Database & Data
						</h3>
						<div class="skill-list">
							<div class="skill-item" data-skill="Database Design & Management">
								<span class="skill-emoji">🗄️</span>
								<span>Database Design & Management</span>
							</div>
							<div class="skill-item" data-skill="MySQL">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" alt="MySQL" />
								<span>MySQL</span>
							</div>
							<div class="skill-item" data-skill="PostgreSQL">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" alt="PostgreSQL" />
								<span>PostgreSQL</span>
							</div>
							<div class="skill-item" data-skill="SQL">
								<span class="skill-emoji">🔎</span>
								<span>SQL</span>
							</div>
							<div class="skill-item" data-skill="DBeaver">
								<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dbeaver/dbeaver-original.svg" alt="DBeaver" />
								<span>DBeaver</span>
							</div>
							<div class="skill-item" data-skill="ERD">
								<span class="skill-emoji">🔗</span>
								<span>ERD</span>
							</div>
							<div class="skill-item" data-skill="Data Modelling">
								<span class="skill-emoji">🧩</span>
								<span>Data Modelling</span>
							</div>
							<div class="skill-item" data-skill="ETL Concepts">
								<span class="skill-emoji">🔄</span>
								<span>ETL Concepts</span>
							</div>
						</div>
					</div>

					<div class="skill-group reveal reveal-delay-1">
